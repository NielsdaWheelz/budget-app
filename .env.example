# Required. Direct (non-pooled) Neon Postgres connection string.
# We use the unpooled endpoint because Bun's TLS layer does not yet
# negotiate cleanly through Neon's PgBouncer pooler.
DATABASE_URL_UNPOOLED=postgres://user:password@host/dbname?sslmode=require

# Required. Canonical browser origin; no path or trailing slash.
BUDGET_ORIGIN=https://budget.example.com
# Required. Registered owner email mapped to the integration credentials.
BUDGET_OWNER_EMAIL=owner@example.com
# Required. Distinct sha256 hex digests of random 32-byte read and write tokens.
# Generate tokens locally; give their plaintext values to jarvis, never to the browser.
BUDGET_READ_TOKEN_SHA256=
BUDGET_WRITE_TOKEN_SHA256=
